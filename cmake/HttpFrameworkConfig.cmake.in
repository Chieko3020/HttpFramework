@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# 传递依赖 — 外部项目引用 HttpFramework 时必须能找到这些包
find_dependency(Threads)
find_dependency(Boost COMPONENTS system)

# WSS 扩展需要 OpenSSL（仅在构建时开启了 ENABLE_WSS 时生效）
if(@ENABLE_WSS@)
    find_dependency(OpenSSL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HttpFrameworkTargets.cmake")

check_required_components(HttpFramework)
